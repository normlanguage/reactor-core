Module module() {
  return module(
    name: "reactor.core",
    version: 5,
    exports: ["publisher.Flux"],
    dependencies: [dependency(repository: "norm", name: "java.base", version: 1)],
    binding: jarBinding(
      target: mavenJar(
        group: "io.projectreactor",
        artifact: "reactor-core",
        version: "3.8.7", resolution: sha256("65112b83e06099bff5f9882dce2336e3e58a3e791467193813f725bc3e727c75")
      ),
      api: [
        jarType(
          name: "reactor.core.publisher.Flux", alias: "publisher.Flux",
          members: ["filter", "map"],
          overloads: [
            jarOverload(name: "empty", parameterTypes: []),
            jarOverload(name: "error", parameterTypes: ["java.lang.Throwable"]),
            jarOverload(name: "just", parameterTypes: ["java.lang.Object"]),
            jarOverload(name: "take", parameterTypes: ["long"]),
            jarOverload(name: "blockLast", parameterTypes: ["java.time.Duration"])
          ]
        )
      ]
    )
  )
}
