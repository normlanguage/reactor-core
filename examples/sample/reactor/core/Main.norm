package sample.reactor.core

import reactor.core.publisher.Flux
import reactor.core.publisher.fluxJust
import java.base.time.durationOfSeconds

Flux<String>? notification() {
  return fluxJust<String>(arg0: "Norm event")
}

Void main() {
  Flux<String>? stream = notification()
  if stream != null {
    printLine(stream.blockLast(durationOfSeconds(2)) ?? "")
  }
}
